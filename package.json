{
  "name": "triple-yahtzee-score-board",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --configuration ci",
    "lint": "eslint . --fix",
    "e2e": "playwright test",
    "preinstall": "npx only-allow pnpm",
    "prepare": "is-ci || simple-git-hooks",
    "typecheck": "tsc --noEmit --project tsconfig.app.json && tsc --noEmit --project tsconfig.spec.json && tsc --noEmit --project tsconfig.e2e.json",
    "sandcastle": "LC_ALL=C tsx .sandcastle/main.mts",
    "build-image": ".sandcastle/build.sh"
  },
  "dependencies": {
    "@angular-architects/ngrx-toolkit": "catalog:",
    "@angular/cdk": "catalog:",
    "@angular/common": "catalog:",
    "@angular/compiler": "catalog:",
    "@angular/core": "catalog:",
    "@angular/forms": "catalog:",
    "@angular/platform-browser": "catalog:",
    "@angular/router": "catalog:",
    "@jsverse/transloco": "catalog:",
    "@ngrx/operators": "catalog:",
    "@ngrx/signals": "catalog:",
    "ngxtension": "catalog:",
    "rxjs": "catalog:",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "catalog:",
    "@analogjs/vite-plugin-angular": "catalog:",
    "@analogjs/vitest-angular": "catalog:",
    "@angular/build": "catalog:",
    "@angular/cli": "catalog:",
    "@angular/compiler-cli": "catalog:",
    "@fabdeh/eslint-config": "catalog:",
    "@ngx-env/builder": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/angular": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "dotenv": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-better-tailwindcss": "catalog:",
    "eslint-plugin-erasable-syntax-only": "catalog:",
    "eslint-plugin-format": "catalog:",
    "is-ci": "catalog:",
    "jsdom": "catalog:",
    "nano-staged": "catalog:",
    "postcss": "catalog:",
    "prettier": "catalog:",
    "simple-git-hooks": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm -w nano-staged && pnpm -r typecheck && pnpm -r test"
  },
  "nano-staged": {
    "*": "eslint --fix --pass-on-no-patterns --no-error-on-unmatched-pattern"
  }
}
