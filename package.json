{
  "name": "triple-yahtzee-score-board",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint . --fix",
    "e2e": "playwright test",
    "preinstall": "npx only-allow pnpm",
    "prepare": "is-ci || simple-git-hooks",
    "typecheck": "tsc --noEmit --project tsconfig.app.json && tsc --noEmit --project tsconfig.spec.json && tsc --noEmit --project tsconfig.e2e.json",
    "sandcastle": "LC_ALL=C tsx .sandcastle/main.mts",
    "build-image": ".sandcastle/build.sh"
  },
  "dependencies": {
    "@angular-architects/ngrx-toolkit": "21.0.1",
    "@angular/cdk": "^21.2.13",
    "@angular/common": "^21.2.15",
    "@angular/compiler": "^21.2.15",
    "@angular/core": "^21.2.15",
    "@angular/forms": "^21.2.15",
    "@angular/platform-browser": "^21.2.15",
    "@angular/router": "^21.2.15",
    "@jsverse/transloco": "^8.3.0",
    "@ngrx/operators": "21.0.0",
    "@ngrx/signals": "21.0.0",
    "ngxtension": "^7.2.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.7.0",
    "@analogjs/vite-plugin-angular": "^2.5.2",
    "@analogjs/vitest-angular": "^2.5.2",
    "@angular/build": "^21.2.13",
    "@angular/cli": "^21.2.13",
    "@angular/compiler-cli": "^21.2.15",
    "@fabdeh/eslint-config": "^0.11.1",
    "@ngx-env/builder": "^21.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/angular": "^19.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-plugin-better-tailwindcss": "^4.5.0",
    "eslint-plugin-erasable-syntax-only": "^0.4.1",
    "eslint-plugin-format": "^2.0.1",
    "is-ci": "^4.1.0",
    "jsdom": "^28.1.0",
    "nano-staged": "^1.0.2",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.7"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm -w nano-staged && pnpm -r typecheck && pnpm -r test"
  },
  "nano-staged": {
    "*": "eslint --fix --pass-on-no-patterns --no-error-on-unmatched-pattern"
  }
}
